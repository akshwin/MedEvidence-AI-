## Backend env (Render/Railway/Fly/VPS)
## Copy to `backend/.env` (DO NOT commit `.env`)

# Required
GROQ_API_KEY=your_groq_api_key
SECRET_KEY=generate_a_long_random_string
FRONTEND_URL=https://your-frontend.vercel.app

# Database
# Recommended for production (Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./researchgpt.db

# Production toggle
DEBUG=False

# Optional: Email (contact form + verification/reset emails if enabled)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Optional: Monitoring
SENTRY_DSN=


